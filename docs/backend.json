
{
  "entities": {
    "Donation": {
      "title": "Donation",
      "type": "object",
      "description": "Represents a single donation transaction.",
      "properties": {
        "transactionId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "userId": { "type": "string", "description": "The ID of the user who made the donation." },
        "payerEmail": { "type": "string", "format": "email" },
        "payerName": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "cause": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["transactionId", "amount", "currency", "payerEmail", "status", "timestamp"]
    },
    "ContactMessage": {
      "title": "Contact Message",
      "type": "object",
      "description": "Message sent via contact form.",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/donations/{donationId}": {
      "schema": { "$ref": "#/entities/Donation" },
      "description": "Donations log for donors and admins."
    },
    "/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Contact form submissions."
    },
    "/users/{userId}/profile": {
      "schema": {
        "type": "object",
        "properties": {
          "fullName": { "type": "string" },
          "email": { "type": "string" }
        }
      }
    }
  }
}
