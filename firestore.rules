
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserEmail() {
      return isSignedIn() && request.auth.token.email != null 
        ? request.auth.token.email.lower() 
        : "";
    }

    function isAdmin() {
      return getUserEmail() == "chaya123@chayaisrael.com";
    }

    match /donations/{donationId} {
      // Anyone can create a donation (guest checkout)
      allow create: if true;
      
      // Admin can read all. 
      // Users can read only their own donations.
      // Important: For queries (list), the query must include a filter on payerEmail.
      allow read: if isAdmin() || (isSignedIn() && resource.data.payerEmail == getUserEmail());
      
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if true; 
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/profile/{document=**} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
