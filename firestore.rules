rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // הרשאות פתוחות לחלוטין לצורך שלב הבנייה ופתרון שגיאות Permissions
    match /donations/{donationId} {
      allow read, write: if true;
      
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    match /users/{userId} {
      allow read, write: if true;
      
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // ברירת מחדל פתוחה לכל שאר המסמכים
    match /{document=**} {
      allow read, write: if true;
    }
  }
}