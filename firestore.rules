
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "chaya123@chayaisrael.com"
      );
    }

    match /donations/{donationId} {
      // Anyone can create a donation (guest checkout)
      allow create: if true;
      
      // Admin can read all
      allow read: if isAdmin();
      
      // Users can read their own donations based on email match.
      // Firestore filters queries based on rules, so the query must strictly 
      // filter by payerEmail for this rule to allow a 'list' operation.
      allow read: if isSignedIn() && (
        resource.data.payerEmail == request.auth.token.email.lower()
      );
      
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if true; 
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/profile/{document=**} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /{path=**} {
      allow read, write: if isAdmin();
    }
  }
}
