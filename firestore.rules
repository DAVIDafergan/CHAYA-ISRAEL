rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // פתיחת הרשאות מלאה לשלב הפיתוח והבנייה כפי שמתבקש
    // מאפשר לכל המשתמשים (מחוברים או לא) לראות ולכתוב נתונים כדי למנוע שגיאות Permissions
    match /{document=**} {
      allow read, write: if true;
    }
  }
}