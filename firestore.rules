rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permissive rules for development phase as requested.
    // This allows all reads and writes to ensure no "Missing or insufficient permissions" errors occur during building.
    // In a production environment, these must be restricted to authenticated users and specific document ownership.
    
    match /{document=**} {
      allow read, write: if true;
    }
    
    match /donations/{donationId} {
      allow read, write: if true;
    }
    
    match /users/{userId}/{any=**} {
      allow read, write: if true;
    }
  }
}